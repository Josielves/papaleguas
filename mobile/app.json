{
  "expo": {
    "name": "Papa-léguas",
    "slug": "papaleguas",
    "version": "2.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "papaleguas",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#C4FF00"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.papaleguas.app",
      "versionCode": 6,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#C4FF00",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#C4FF00",
          "defaultChannel": "viagens"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O Papaleguas usa sua localização para mostrar embarque e acompanhar a viagem em tempo real."
        }
      ]
    ]
  }
}
