{
  "name": "papaleguas",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "validate": "npm run build",
    "validate:audit": "npm audit --audit-level=moderate",
    "brand:assets": "node scripts/generate-brand-assets.mjs",
    "android:assets": "npm run brand:assets && npx capacitor-assets generate --android",
    "android:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run android:sync && node scripts/build-android.mjs",
    "android:open": "npx cap open android",
    "load:routes": "k6 run tests/load/search-routes.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@supabase/supabase-js": "^2.45.4",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  }
}
